#include<iostream>
using namespace std;
class stack
{
   private:
      int arr[5];
      int top;
   public:
      stack(){
         top=-1;
      }
      void push(int value)
      {
         if(top>=4)
         {
            throw "stack overflow:cannot push,stack is full";
         }
         arr[++top]=value;
         cout<<"pushed:"<<value<<endl;
      }
      int pop(){
         if(top<0)
         {
            throw "stack underflow:cannot pop,stack is empty";
         }
         cout<<"popped:"<<arr[top]<<endl;
         return arr[top--];
      }
};
int main()
{
   stack s;
   try{
      cout<<"trying to pop from empty stack:"<<endl;
      s.pop();
      cout<<"trying to push 6 elements:"<<endl;
      for(int i=0;i<6;i++)
      {
         s.push(i);
      }
      cout<<"trying to pop 6 elements:"<<endl;
      for(int i=0;i<6;++i)
      {
         s.pop();
      }
   }
   catch(char*msg)
   {
      cout<<"caught exception:"<<msg<<endl;
   }
   catch(...){
      cout<<"caught an unknown exception"<<endl;
   }
   return 0;
}
